<?php
require_once 'config.php';
if (empty($_SESSION['user_id']) || ($_SESSION['user_role'] ?? '') !== 'student') {
    header('Location: login_student.html');
    exit;
}

$userId   = $_SESSION['user_id'];
$userName = $_SESSION['user_name'] ?? '';

// User info
$stmt = $conn->prepare('SELECT full_name, student_id, email, department, created_at FROM users WHERE user_id = ?');
$stmt->bind_param('i', $userId);
$stmt->execute();
$stmt->bind_result($fullName, $studentId, $email, $department, $createdAt);
$stmt->fetch();
$stmt->close();

$displayName = trim($fullName ?: $userName ?: 'Student');
$shortName   = explode(' ', $displayName)[0] ?: $displayName;
$joinedDate  = $createdAt ? date('F j, Y', strtotime($createdAt)) : 'Unknown';

// Upcoming events count
$eventCount = 0;
$stmtE = $conn->prepare('SELECT COUNT(*) FROM events WHERE event_date >= CURDATE()');
if ($stmtE) { $stmtE->execute(); $stmtE->bind_result($eventCount); $stmtE->fetch(); $stmtE->close(); }

// Latest 2 upcoming events
$upcomingEvents = [];
$stmtEv = $conn->prepare('SELECT title, event_date, event_time, venue FROM events WHERE event_date >= CURDATE() ORDER BY event_date ASC LIMIT 2');
if ($stmtEv) { $stmtEv->execute(); $r = $stmtEv->get_result(); while ($row = $r->fetch_assoc()) $upcomingEvents[] = $row; $stmtEv->close(); }

// Announcements count
$announcementCount = 0;
$stmtA = $conn->prepare('SELECT COUNT(*) FROM announcements');
if ($stmtA) { $stmtA->execute(); $stmtA->bind_result($announcementCount); $stmtA->fetch(); $stmtA->close(); }

// Latest 2 announcements
$latestAnnouncements = [];
$stmtAn = $conn->prepare('SELECT title, created_at FROM announcements ORDER BY created_at DESC LIMIT 2');
if ($stmtAn) { $stmtAn->execute(); $r = $stmtAn->get_result(); while ($row = $r->fetch_assoc()) $latestAnnouncements[] = $row; $stmtAn->close(); }
?>
